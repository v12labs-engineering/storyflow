# Supabase v1 project settings. The anon key is intended for browser use;
# authorization must still be enforced with Supabase RLS and server checks.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Widget bundle URL. For local widget development, webpack serves main.bundle.js on port 6010.
NEXT_PUBLIC_STORYFLOW_WIDGET="http://localhost:6010/main.bundle.js"

# Optional browser-side media search integrations. These keys are public by design.
NEXT_PUBLIC_PEXELS_KEY=""
NEXT_PUBLIC_PIXABAY_KEY=""

# Server-only Backblaze B2 application credentials.
BACKBLAZE_APP_ID="your-application-key-id"
BACKBLAZE_APP_KEY="your-application-key"

# Server-only Layerhub editor service configuration. Never prefix the token
# with NEXT_PUBLIC_ or reference it from browser code.
STORYFLOW_EDITOR_API_URL="https://your-editor-service.example.com"
STORYFLOW_EDITOR_API_TOKEN="your-editor-service-token"
