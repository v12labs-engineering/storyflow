{
  "name": "storyflow",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "tsc": "turbo run tsc",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint-config-custom": "workspace:*",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "prettier": "2.8.8",
    "turbo": "1.13.4"
  },
  "engines": {
    "node": ">=18.0.0 <21"
  },
  "packageManager": "pnpm@7.13.4",
  "lint-staged": {
    "*.{tsx, ts}": [
      "eslint --fix --quiet"
    ],
    "*.{jsx, js}": [
      "eslint --fix --quiet"
    ]
  }
}
